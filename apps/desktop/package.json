{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@tessera/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "imports": {
    "#components/*": "./src/renderer/src/components/*.tsx",
    "#hooks/*": "./src/renderer/src/hooks/*.ts",
    "#lib/*": "./src/renderer/src/lib/*.ts"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "benchmark:editor": "bun run build && electron scripts",
    "benchmark:editor:check": "bun run build && electron scripts --check",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "clean": "rm -rf out"
  },
  "dependencies": {
    "@tessera/ai": "workspace:*",
    "@tessera/contracts": "workspace:*",
    "@tessera/core": "workspace:*",
    "@tessera/database": "workspace:*",
    "@tessera/design-system": "workspace:*",
    "@tiptap/core": "3.30.2",
    "@tiptap/extension-table": "3.30.2",
    "@tiptap/extension-task-item": "3.30.2",
    "@tiptap/extension-task-list": "3.30.2",
    "@tiptap/markdown": "3.30.2",
    "@tiptap/pm": "3.30.2",
    "@tiptap/react": "3.30.2",
    "@tiptap/starter-kit": "3.30.2",
    "better-sqlite3": "^13.0.3",
    "motion": "^12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "42.3.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.2",
    "vite": "7.1.10",
    "vitest": "^4.1.11"
  }
}
