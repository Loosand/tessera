{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "tessera",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "trustedDependencies": ["electron"],
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "postinstall": "node apps/desktop/node_modules/electron/install.js",
    "dev": "bun --cwd apps/desktop dev",
    "build": "turbo run build",
    "benchmark:editor": "bun --cwd apps/desktop benchmark:editor",
    "benchmark:editor:check": "bun --cwd apps/desktop benchmark:editor:check",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "biome check . && bun run typecheck && bun run test && bun run build",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "24.12.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "turbo": "2.10.2",
    "typescript": "5.8.2"
  }
}
