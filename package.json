{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "tessera",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "trustedDependencies": ["electron"],
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "postinstall": "node apps/desktop/node_modules/electron/install.js",
    "dev": "bun --cwd apps/desktop dev",
    "dev:electron": "bun --cwd apps/desktop dev",
    "dev:tauri": "bun --cwd apps/desktop-tauri dev",
    "build": "turbo run build",
    "build:electron": "bun --cwd apps/desktop build",
    "build:tauri": "bun --cwd apps/desktop-tauri build",
    "dist:mac": "bun --cwd apps/desktop dist:mac",
    "dist:mac:release": "bun --cwd apps/desktop dist:mac:release",
    "dist:tauri:mac": "bun --cwd apps/desktop-tauri dist:mac",
    "benchmark:editor": "bun --cwd apps/desktop benchmark:editor",
    "benchmark:editor:check": "bun --cwd apps/desktop benchmark:editor:check",
    "benchmark:editor:parser": "bun --cwd apps/desktop benchmark:editor:parser",
    "benchmark:editor:parser:cpu": "bun --cwd apps/desktop benchmark:editor:parser:cpu",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "biome check . && bun run typecheck && bun run test && bun run build",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "24.12.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "turbo": "2.10.2",
    "typescript": "5.8.2"
  }
}
