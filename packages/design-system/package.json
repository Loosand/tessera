{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@tessera/design-system",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./components/icons": "./components/icons/index.ts",
    "./components/ui/*": "./components/ui/*.tsx",
